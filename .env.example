# ── AI Code Review Bot — environment variables ──────────────────────────────
#
# Copy this file to .env and fill in your values.
# NEVER commit your real .env file to source control.
# ─────────────────────────────────────────────────────────────────────────────

# GitHub personal access token (needs repo + pull_requests scopes).
# When running in GitHub Actions this is automatically provided via
# ${{ secrets.GITHUB_TOKEN }}.
GITHUB_TOKEN=ghp_your_token_here

# Google Gemini API key from https://aistudio.google.com/
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here
